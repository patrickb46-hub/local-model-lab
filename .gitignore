# =============================================================================
# Local-Model-Lab · 发布用 .gitignore
# -----------------------------------------------------------------------------
# 原则：GitHub 只发布「代码 / 文档 / 实验报告」，
#       绝不发布模型权重（单文件最大 4.2 GB，GitHub 单文件上限仅 100 MB）。
# =============================================================================

# ---------------- 模型权重（最大 4.2 GB/个，绝对不能上传）----------------
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.onnx
*.ckpt
*.h5
*.msgpack
*.safetensors.index.json

# ---------------- 模型配套资产（tokenizer / 词表：体积大且非本项目原创）----------------
tokenizer.json
tokenizer_config.json
vocab.json
merges.txt
added_tokens.json
special_tokens_map.json
generation_config.json
*.jinja

# ---------------- 目录级排除 ----------------
# 底座模型本体（Qwen 权重 + tokenizer，4.3 GB）
/base/
# 历史备份（917 MB）
/backup/
# 根目录过程日志（137 MB，正式报告已收在 shared/results/）
/logs/
# WorkBuddy 内部记忆，与项目无关
/.workbuddy/

# 各分支的模型产物目录（权重 / 合并模型 / LoRA adapter），仅保留 data/ 与 logs/
branch-*/model/
branch-*/merged/
# 通配所有 adapter*（含 adapter-A1/A2/B/C、adapter-DEMO-* 等演示产物）
branch-*/adapter*/
adapter-DEMO-*/

# ---------------- 构建产物（由 build_site.py 生成，可随时重建）----------------
/site/
# WorkBuddy 发布应用的内部标记文件
/.wbapp_*.genie

# ---------------- 系统与临时文件 ----------------
.DS_Store
__pycache__/
*.pyc
*.log
*.bak

# ---------------- 凭据类（双保险，防止误提交）----------------
.env
.env.*
*.pem
*.key
id_rsa*
*credential*
*secret*
*token*.json
